# Copiez ce fichier en ".env" (dans ce dossier) et remplissez-le.
# Code d'invitation du groupe WhatsApp des commandes : la partie après
# https://chat.whatsapp.com/ dans le lien d'invitation du groupe.
GROUP_INVITE=
# Doit être identique à BRIDGE_TOKEN côté backend (valeur par défaut des deux côtés : ma-boutique-secret)
BRIDGE_TOKEN=ma-boutique-secret
BRIDGE_PORT=3100
